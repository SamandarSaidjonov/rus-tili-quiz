---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProgressRing from '../components/ProgressRing.astro';
import { dashCatalog } from '../lib/dash-catalog.ts';
import { url, SECTIONS } from '../lib/url.ts';
import type { IconName } from '../lib/icons.ts';

const catalog = await dashCatalog();

const icons: Record<string, IconName> = {
  mavzular: 'book',
  mashqlar: 'pencil',
  lugatlar: 'cards',
  testlar: 'test',
};

const counts: Record<string, string> = {
  mavzular: `${catalog.topics.length} та мавзу`,
  mashqlar: `${catalog.exSets.reduce((a, s) => a + s.n, 0)} та машқ`,
  lugatlar: `${catalog.vocab.reduce((a, v) => a + v.n, 0)} та сўз`,
  testlar: `${catalog.tests.length} та тест`,
};
---

<Base title="Рус тили" wide>
  <div class="rt-pagehead">
    <h1>Рус тили</h1>
    <div class="rt-pagehead__end">
      <button
        class="rt-iconbtn"
        id="theme-btn"
        type="button"
        aria-label="Темани алмаштириш"
        title="Темани алмаштириш"
      >
        <Icon name="sun" class="rt-theme__sun" />
        <Icon name="moon" class="rt-theme__moon" />
      </button>
      <button
        class="rt-iconbtn rt-iconbtn--danger"
        id="clear-btn"
        type="button"
        aria-label="Барча прогрессни тозалаш"
        title="Барча прогрессни тозалаш"
      >
        <Icon name="trash" />
      </button>
    </div>
  </div>

  <p class="rt-muted">Мавзулар бўйича тушунтиришлар, машқлар, луғат ва тестлар</p>

  <p id="clear-msg" class="rt-notice" role="status"></p>

  <div class="rt-stack--tight rt-stack">
    <a class="rt-overall" href={url('natijalar')}>
      <ProgressRing />
      <span>
        <span class="rt-overall__title" role="heading" aria-level="2">Умумий прогресс</span>
        <span class="rt-overall__meta" data-activity>Натижаларни кўриш</span>
      </span>
      <span class="rt-section__go">
        <Icon name="chevron-right" />
      </span>
    </a>
    <a class="rt-btn rt-btn--secondary rt-btn--block" data-next hidden href={url('mavzular')}>
      <span data-next-text>Давом этиш</span>
      <Icon name="arrow-right" />
    </a>
  </div>

  <div class="rt-stack--tight rt-grid rt-grid--2">
    {
      SECTIONS.map((s) => (
        <a class="rt-section" href={url(s.key)}>
          <span class="rt-section__icon">
            <Icon name={icons[s.key]} />
          </span>
          <span>
            <span class="rt-section__title" role="heading" aria-level="2">
              {s.title}
            </span>
            <span class="rt-section__meta" data-sum={s.key}>
              {counts[s.key]}
            </span>
            <span class="rt-bar" data-sum-bar={s.key}>
              <i style="width:0%" />
            </span>
          </span>
          <span class="rt-section__go">
            <Icon name="chevron-right" />
          </span>
        </a>
      ))
    }
  </div>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} is:inline />

  <script>
    import { hydrateHomeDashboard } from '../lib/dashboard-ui.ts';
    import type { DashCatalog } from '../lib/dashboard.ts';
    import { clearAllProgress, storageAvailable, writeRaw } from '../lib/progress.ts';

    const raw = document.getElementById('catalog')?.textContent ?? '{}';
    try {
      hydrateHomeDashboard(JSON.parse(raw) as DashCatalog);
    } catch {
      /* прогресс кўрсатилмаса ҳам саҳифа ишлайди */
    }

    // Тема: тизим созламасини кузатамиз, танлов `localStorage` да сақланади.
    // Тугмадаги қуёш/ой иконкасини CSS ўзи алмаштиради (`.rt-theme__sun`, `.rt-theme__moon`).
    const isDark = (): boolean => {
      const root = document.documentElement;
      return root.dataset.theme
        ? root.dataset.theme === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
    };
    document.getElementById('theme-btn')?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      writeRaw('rt2:theme', next);
    });

    const msg = document.getElementById('clear-msg');
    if (!storageAvailable() && msg) {
      msg.textContent = 'Диққат: бу браузерда прогресс сақланмайди (шахсий режим бўлиши мумкин).';
    }

    document.getElementById('clear-btn')?.addEventListener('click', () => {
      if (!confirm('Барча прогресс ўчирилади. Давом этамизми?')) return;
      clearAllProgress();
      if (msg) msg.textContent = 'Прогресс тозаланди.';
      location.reload();
    });

    // Эски ҳаволалар: #dars-1, #dars-2, #mashq-1
    const LEGACY: Record<string, string> = {
      'dars-1': 'lugatlar',
      'dars-2': 'lugatlar/003-feellar',
      'mashq-1': 'mashqlar/mixed',
    };
    const hash = location.hash.replace(/^#/, '');
    const target = LEGACY[hash];
    if (target) {
      const base = import.meta.env.BASE_URL.endsWith('/')
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;
      location.replace(`${base}${target}/`);
    }
  </script>
</Base>
