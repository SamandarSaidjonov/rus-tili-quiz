---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url, SECTIONS } from '../lib/url.ts';
import type { IconName } from '../lib/icons.ts';

const topics = await getCollection('topics');
const vocab = await getCollection('vocab');
const exercises = await getCollection('exercises');
const tests = await getCollection('tests');

// Машқлар мавзу (папка) бўйича бирлаштирилади: mixed/translate → mixed
const exByTopic = new Map<string, number>();
for (const e of exercises) {
  exByTopic.set(e.data.topic, (exByTopic.get(e.data.topic) ?? 0) + e.data.items.length);
}

const catalog = {
  topics: topics.map((t) => t.id),
  vocab: vocab.map((v) => ({ id: v.id, n: v.data.words.length })),
  ex: [...exByTopic.entries()].map(([id, n]) => ({ id, n })),
  tests: tests.map((t) => t.id),
};

const icons: Record<string, IconName> = {
  mavzular: 'book',
  mashqlar: 'pencil',
  lugatlar: 'cards',
  testlar: 'test',
};

const counts: Record<string, string> = {
  mavzular: `${topics.length} та мавзу`,
  mashqlar: `${[...exByTopic.values()].reduce((a, b) => a + b, 0)} та машқ`,
  lugatlar: `${vocab.reduce((a, v) => a + v.data.words.length, 0)} та сўз`,
  testlar: `${tests.length} та тест`,
};
---

<Base title="Рус тили">
  <div class="rt-pagehead">
    <h1>Рус тили</h1>
  </div>

  <p class="rt-muted">
    Мавзулар бўйича тушунтириш, падежлар машқлари, луғат ва тестлар. Ҳаммаси телефонда ишлайди,
    прогресс шу браузерда сақланади.
  </p>

  <div class="rt-stack--tight">
    {
      SECTIONS.map((s) => (
        <a class="rt-section" href={url(s.key)}>
          <span class="rt-section__icon">
            <Icon name={icons[s.key]} />
          </span>
          <span>
            <span class="rt-section__title" role="heading" aria-level="2">
              {s.title}
            </span>
            <span class="rt-section__meta" data-sum={s.key}>
              {counts[s.key]}
            </span>
            <span class="rt-bar" data-sum-bar={s.key}>
              <i style="width:0%" />
            </span>
          </span>
          <span class="rt-section__go">
            <Icon name="chevron-right" />
          </span>
        </a>
      ))
    }
  </div>

  <section class="rt-card">
    <h2 class="rt-item__title">Созламалар</h2>
    <p class="rt-item__meta">
      Прогресс фақат шу телефон ва браузерда сақланади. Эски версиядаги натижалар автоматик
      кўчирилди.
    </p>
    <div class="rt-row">
      <button class="rt-btn rt-btn--secondary" id="theme-btn" type="button">
        Қоронғи темага ўтиш
      </button>
      <a class="rt-btn rt-btn--secondary" href={url('legacy/index.html')}>Эски версияни очиш</a>
    </div>
    <div>
      <button class="rt-link" id="clear-btn" type="button">Барча прогрессни тозалаш</button>
    </div>
    <p id="clear-msg" class="rt-item__meta" role="status"></p>
  </section>

  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} is:inline />

  <script>
    import { hydrateHome, type Catalog } from '../lib/progress-ui.ts';
    import { clearAllProgress, storageAvailable, writeRaw } from '../lib/progress.ts';

    const raw = document.getElementById('catalog')?.textContent ?? '{}';
    try {
      hydrateHome(JSON.parse(raw) as Catalog);
    } catch {
      /* прогресс кўрсатилмаса ҳам саҳифа ишлайди */
    }

    // Тема: тизим созламасини кузатамиз, танлов `localStorage` да сақланади.
    const themeBtn = document.getElementById('theme-btn');
    const isDark = (): boolean => {
      const root = document.documentElement;
      return root.dataset.theme
        ? root.dataset.theme === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
    };
    const labelTheme = (): void => {
      if (themeBtn) themeBtn.textContent = isDark() ? 'Ёруғ темага ўтиш' : 'Қоронғи темага ўтиш';
    };
    labelTheme();
    themeBtn?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      writeRaw('rt2:theme', next);
      labelTheme();
    });

    const msg = document.getElementById('clear-msg');
    if (!storageAvailable() && msg) {
      msg.textContent = 'Диққат: бу браузерда прогресс сақланмайди (шахсий режим бўлиши мумкин).';
    }

    document.getElementById('clear-btn')?.addEventListener('click', () => {
      if (!confirm('Барча прогресс ўчирилади. Давом этамизми?')) return;
      clearAllProgress();
      if (msg) msg.textContent = 'Прогресс тозаланди.';
      location.reload();
    });

    // Эски ҳаволалар: #dars-1, #dars-2, #mashq-1
    const LEGACY: Record<string, string> = {
      'dars-1': 'lugatlar',
      'dars-2': 'lugatlar/003-feellar',
      'mashq-1': 'mashqlar/mixed',
    };
    const hash = location.hash.replace(/^#/, '');
    const target = LEGACY[hash];
    if (target) {
      const base = import.meta.env.BASE_URL.endsWith('/')
        ? import.meta.env.BASE_URL
        : `${import.meta.env.BASE_URL}/`;
      location.replace(`${base}${target}/`);
    }
  </script>
</Base>
