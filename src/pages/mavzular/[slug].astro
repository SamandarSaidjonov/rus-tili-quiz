---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url.ts';

export const getStaticPaths = (async () => {
  const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
  return topics.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? topics[i - 1] : null,
      next: i + 1 < topics.length ? topics[i + 1] : null,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const exercisesTopic = entry.data.exercises ?? entry.id;
const hasExercises = (await getCollection('exercises')).some((e) => e.data.topic === exercisesTopic);
---

<Base title={entry.data.title} section="mavzular" description={entry.data.short}>
  <article class="rt-topic">
    <header>
      <p class="rt-label">{entry.data.order}-мавзу</p>
      <h1>{entry.data.title}</h1>
    </header>

    <p class="rt-lead">{entry.data.short}</p>

    {
      !entry.data.reviewed && (
        <p class="rt-item__meta">Бу мавзуни ўқитувчи ҳали текширмаган.</p>
      )
    }

    <div class="rt-prose">
      <Content />
    </div>

    {
      hasExercises && (
        <aside class="rt-card">
          <h2 class="rt-item__title">Шу мавзу бўйича машқлар</h2>
          <p class="rt-item__meta">Жавобни рус ҳарфларида ўзингиз ёзасиз.</p>
          <a class="rt-btn rt-btn--primary" href={url(`mashqlar/${exercisesTopic}`)}>
            Машқларни бошлаш
          </a>
        </aside>
      )
    }

    <nav class="rt-pager" aria-label="Мавзулар орасида юриш">
      {
        prev ? (
          <a href={url(`mavzular/${prev.id}`)}>
            <small>← Олдинги мавзу</small>
            <b>{prev.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={url(`mavzular/${next.id}`)}>
            <small>Кейинги мавзу →</small>
            <b>{next.data.title}</b>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>

  <div id="topic-meta" data-topic={entry.id} hidden></div>
  <script>
    // Мавзу очилганда «ўқилди» деб белгиланади.
    import { recordAnswer } from '../../lib/progress.ts';
    const id = document.getElementById('topic-meta')?.dataset.topic;
    if (id) recordAnswer('topic', 'read', id, true);
  </script>
</Base>
