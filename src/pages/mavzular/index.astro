---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url.ts';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Мавзулар" section="mavzular" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url()} aria-label="Бош саҳифага қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>Мавзулар</h1>
  </div>

  <p class="rt-muted">
    Фақат тушунтириш ва жадваллар. Машқлар алоҳида бўлимда.
  </p>

  {
    topics.length === 0 && (
      <div class="rt-card">
        <p style="margin:0">Мавзулар ҳозир тайёрланмоқда.</p>
      </div>
    )
  }

  <div class="rt-stack--tight rt-grid">
    {
      topics.map((t) => (
        <a class="rt-item" href={url(`mavzular/${t.id}`)}>
          <div class="rt-item__head">
            <h2 class="rt-item__title">
              {t.data.order}. {t.data.title}
            </h2>
            <span class="rt-badge rt-badge--todo" data-prog-seen={t.id}>
              Ўқилмаган
            </span>
          </div>
          <p class="rt-item__meta">{t.data.short}</p>
        </a>
      ))
    }
  </div>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
