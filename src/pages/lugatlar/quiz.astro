---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import VocabQuiz from '../../components/VocabQuiz.tsx';
import { url } from '../../lib/url.ts';
import type { VocabSet } from '../../lib/types.ts';

const entries = (await getCollection('vocab')).sort((a, b) => a.data.order - b.data.order);
const sets: VocabSet[] = entries.map((e) => ({ id: e.id, ...e.data }));
const total = sets.reduce((n, s) => n + s.words.length, 0);
---

<Base title="Луғат сўраш" section="lugatlar">
  <TopBar
    slot="topbar"
    title="Луғат сўраш"
    sub={`${total} та сўз · савол ўзбекча, вариантлар русча`}
    backHref={url('lugatlar')}
    backLabel="Луғатлар рўйхатига қайтиш"
  />

  <VocabQuiz sets={sets} homeHref={url()} listHref={url('lugatlar')} client:only="preact" />
</Base>
