---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RuText from '../../components/RuText.astro';
import SpeakButton from '../../components/SpeakButton.astro';
import { url } from '../../lib/url.ts';

export const getStaticPaths = (async () => {
  const sets = await getCollection('vocab');
  return sets.map((s) => ({ params: { set: s.id }, props: { set: s } }));
}) satisfies GetStaticPaths;

const { set } = Astro.props;
const { title, pages, note, words } = set.data;
---

<Base title={title} section="lugatlar" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url('lugatlar')} aria-label="Луғатлар рўйхатига қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>{title}</h1>
  </div>

  <p class="rt-muted">{words.length} та сўз{pages ? ` · ${pages}` : ''}</p>
  {note && <p class="rt-note">{note}</p>}

  <div class="rt-row">
    <a class="rt-btn rt-btn--primary" href={`${url('lugatlar/quiz')}?set=${set.id}`}>
      Мавзу бўйича топшириш
    </a>
    <button class="rt-btn rt-btn--secondary" type="button" id="view-btn" aria-pressed="false">
      Жадвалда кўриш
    </button>
  </div>

  <div id="cards" class="rt-stack--tight rt-grid">
    {
      words.map((w) => (
        <article class="rt-card">
          <div class="rt-vocab__head">
            <div class="rt-vocab__words">
              {w.pos && <p class="rt-vocab__pos">{w.pos}</p>}
              <h2 class="rt-vocab__ru" lang="ru">
                <RuText text={w.ru} />
              </h2>
              <p class="rt-vocab__uz">{w.uz}</p>
            </div>
            <SpeakButton text={w.ru} />
          </div>

          {w.example?.ru && (
            <div class="rt-example">
              <p class="rt-label">Мисол</p>
              <p class="rt-example__ru" lang="ru">
                <RuText text={w.example.ru} />
                <SpeakButton text={w.example.ru} small label="Гапни тинглаш" />
              </p>
              {w.example.uz && <p class="rt-example__uz">{w.example.uz}</p>}
            </div>
          )}

          {w.note && (
            <div class="rt-note">
              <p class="rt-label">Изоҳ</p>
              {w.note}
            </div>
          )}

          {!w.reviewed && <p class="rt-item__meta">Ўқитувчи текширмаган</p>}
        </article>
      ))
    }
  </div>

  <div id="table" class="rt-table-wrap" role="region" aria-label={`${title}: сўзлар жадвали`} tabindex="0" hidden>
    <table class="rt-table">
      <thead>
        <tr>
          <th scope="col">Русча</th>
          <th scope="col">Ўзбекча</th>
          <th scope="col">Сўз туркуми</th>
        </tr>
      </thead>
      <tbody>
        {
          words.map((w) => (
            <tr>
              <td lang="ru">
                <RuText text={w.ru} />
              </td>
              <td>{w.uz}</td>
              <td>{w.pos}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script>
    import { wireSpeak } from '../../lib/speak-ui.ts';
    wireSpeak();

    const btn = document.getElementById('view-btn');
    const cards = document.getElementById('cards');
    const table = document.getElementById('table');
    btn?.addEventListener('click', () => {
      const showTable = table?.hidden ?? false;
      if (cards) cards.hidden = showTable;
      if (table) table.hidden = !showTable;
      btn.textContent = showTable ? 'Карточкада кўриш' : 'Жадвалда кўриш';
      btn.setAttribute('aria-pressed', String(showTable));
    });
  </script>
</Base>
