---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url.ts';

const entries = await getCollection('exercises');
const counts = new Map<string, number>();
for (const e of entries) counts.set(e.data.topic, (counts.get(e.data.topic) ?? 0) + e.data.items.length);
const mixed = [...counts].filter(([id]) => id === 'mixed');
const byTopic = [...counts].filter(([id]) => id !== 'mixed');
const ids = (list: Array<[string, number]>): string => list.map(([id, n]) => `${id}:${n}`).join(' ');
const sum = (list: Array<[string, number]>): number => list.reduce((a, [, n]) => a + n, 0);

const cards = [
  {
    path: 'mashqlar/mixed',
    icon: 'pencil' as const,
    title: 'Аралаш мавзулар',
    hint: 'Ҳамма мавзудан аралаш машқлар',
    count: `${sum(mixed)} та машқ`,
    ids: ids(mixed),
  },
  {
    path: 'mashqlar/mavzu',
    icon: 'book' as const,
    title: 'Танланган мавзу бўйича',
    hint: `${byTopic.length} та мавзу`,
    count: `${sum(byTopic)} та машқ`,
    ids: ids(byTopic),
  },
];
---

<Base title="Машқлар" section="mashqlar" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url()} aria-label="Бош саҳифага қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>Машқлар</h1>
  </div>

  <p class="rt-muted">
    Жавобни рус ҳарфларида ўзингиз ёзасиз. Катта-кичик ҳарф, тиниш белгилари, ё/е фарқи ва
    урғу белгиси хато ҳисобланмайди
  </p>

  <div class="rt-stack rt-stack--tight rt-grid rt-grid--2">
    {
      cards.map((c) => (
        <a class="rt-section" href={url(c.path)} data-sum-kind="ex" data-sum-ids={c.ids}>
          <span class="rt-section__icon">
            <Icon name={c.icon} />
          </span>
          <span>
            <span class="rt-section__title" role="heading" aria-level="2">
              {c.title}
            </span>
            <span class="rt-section__meta">{c.hint}</span>
            <span class="rt-section__meta" data-sum-meta>
              {c.count}
            </span>
            <span class="rt-bar">
              <i style="width:0%" />
            </span>
          </span>
          <span class="rt-section__go">
            <Icon name="chevron-right" />
          </span>
        </a>
      ))
    }
  </div>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
