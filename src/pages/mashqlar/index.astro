---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url.ts';
import { topicMeta } from '../../lib/topics.ts';
import { TYPE_INFO } from '../../lib/exercise.ts';

const entries = await getCollection('exercises');

interface Group {
  slug: string;
  title: string;
  order: number;
  items: number;
  types: string[];
}

const groups = new Map<string, Group>();
for (const e of entries) {
  const meta = topicMeta(e.data.topic);
  const g = groups.get(e.data.topic) ?? {
    slug: e.data.topic,
    title: meta.title,
    order: meta.order,
    items: 0,
    types: [],
  };
  g.items += e.data.items.length;
  g.types.push(TYPE_INFO[e.data.type].name);
  groups.set(e.data.topic, g);
}

const list = [...groups.values()].sort((a, b) => a.order - b.order);
const total = list.reduce((n, g) => n + g.items, 0);
---

<Base title="Машқлар" section="mashqlar">
  <h1>Машқлар</h1>
  <p class="muted">
    {total} машқ. Жавобни рус ҳарфларида ўзингиз ёзасиз. Катта-кичик ҳарф, тиниш белгилари,
    ё/е фарқи ва урғу белгиси хато ҳисобланмайди.
  </p>

  {
    list.length === 0 && (
      <div class="card">
        <p style="margin:0">Машқлар ҳозир тайёрланмоқда.</p>
      </div>
    )
  }

  <div class="cards" style="margin-top:1rem">
    {
      list.map((g) => (
        <div class="card">
          <div class="card__top">
            <span class="card__title">{g.title}</span>
            <span class="badge">{g.items} машқ</span>
          </div>
          <p class="card__meta" style="margin:.2rem 0 0">{g.types.length} тур: {g.types.join(' · ')}</p>
          <p class="card__meta" data-prog={`ex:${g.slug}:${g.items}`} style="margin:.35rem 0 0">…</p>
          <div class="bar" data-prog-bar={`ex:${g.slug}:${g.items}`}>
            <div class="bar__fill" style="width:0%"></div>
          </div>
          <div class="btnrow" style="margin-top:.75rem">
            <a class="btn btn--sm btn--primary" href={url(`mashqlar/${g.slug}`)}>Бошлаш</a>
          </div>
        </div>
      ))
    }
  </div>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
