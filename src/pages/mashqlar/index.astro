---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url.ts';
import { topicMeta } from '../../lib/topics.ts';
import { TYPE_INFO } from '../../lib/exercise.ts';

const entries = await getCollection('exercises');

interface Group {
  slug: string;
  title: string;
  order: number;
  items: number;
  types: string[];
}

const groups = new Map<string, Group>();
for (const e of entries) {
  const meta = topicMeta(e.data.topic);
  const g = groups.get(e.data.topic) ?? {
    slug: e.data.topic,
    title: meta.title,
    order: meta.order,
    items: 0,
    types: [],
  };
  g.items += e.data.items.length;
  g.types.push(TYPE_INFO[e.data.type].name);
  groups.set(e.data.topic, g);
}

const list = [...groups.values()].sort((a, b) => a.order - b.order);
const total = list.reduce((n, g) => n + g.items, 0);
---

<Base title="Машқлар" section="mashqlar" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url()} aria-label="Бош саҳифага қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>Машқлар</h1>
  </div>

  <p class="rt-muted">
    {total} та машқ. Жавобни рус ҳарфларида ўзингиз ёзасиз. Катта-кичик ҳарф, тиниш белгилари,
    ё/е фарқи ва урғу белгиси хато ҳисобланмайди.
  </p>

  {
    list.length === 0 && (
      <div class="rt-card">
        <p style="margin:0">Машқлар ҳозир тайёрланмоқда.</p>
      </div>
    )
  }

  <div class="rt-stack--tight rt-grid">
    {
      list.map((g) => (
        <div class="rt-item">
          <div class="rt-item__head">
            <h2 class="rt-item__title">{g.title}</h2>
            <span class="rt-badge rt-badge--score">{g.items} та машқ</span>
          </div>
          <p class="rt-item__meta">
            {g.types.length} тур: {g.types.join(' · ')}
          </p>
          <p class="rt-item__meta" data-prog={`ex:${g.slug}:${g.items}`}>Ҳали бошланмаган</p>
          <span class="rt-bar" data-prog-bar={`ex:${g.slug}:${g.items}`}>
            <i style="width:0%" />
          </span>
          <div class="rt-item__actions">
            <a class="rt-btn rt-btn--primary" href={url(`mashqlar/${g.slug}`)}>
              Машқни бошлаш
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
