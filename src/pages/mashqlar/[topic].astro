---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import ExerciseRunner from '../../components/ExerciseRunner.tsx';
import { url } from '../../lib/url.ts';
import { topicMeta } from '../../lib/topics.ts';
import type { ExerciseSet } from '../../lib/types.ts';

export const getStaticPaths = (async () => {
  const entries = await getCollection('exercises');
  const topics = [...new Set(entries.map((e) => e.data.topic))];
  return topics.map((topic) => ({
    params: { topic },
    props: {
      topic,
      groups: entries
        .filter((e) => e.data.topic === topic)
        .map((e) => ({ topic: e.data.topic, type: e.data.type, title: e.data.title, ask: e.data.ask, items: e.data.items })),
    },
  }));
}) satisfies GetStaticPaths;

const { topic, groups } = Astro.props as { topic: string; groups: ExerciseSet[] };
const meta = topicMeta(topic);
const count = groups.reduce((n, g) => n + g.items.length, 0);
const hasTopicPage = (await getCollection('topics')).some((t) => t.id === topic);
---

<Base title={`${meta.title} · машқлар`} section="mashqlar">
  <TopBar
    slot="topbar"
    title={meta.title}
    sub={`${groups.length} тур · ${count} та машқ`}
    backHref={url('mashqlar')}
    backLabel="Машқлар рўйхатига қайтиш"
  />

  <ExerciseRunner
    topic={topic}
    title={meta.title}
    groups={groups}
    homeHref={url()}
    listHref={url('mashqlar')}
    topicHref={hasTopicPage ? url(`mavzular/${topic}`) : undefined}
    client:only="preact"
  />
</Base>
