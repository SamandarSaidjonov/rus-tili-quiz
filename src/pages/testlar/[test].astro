---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import TestRunner from '../../components/TestRunner.tsx';
import { url } from '../../lib/url.ts';
import type { TestFile } from '../../lib/types.ts';

export const getStaticPaths = (async () => {
  const tests = await getCollection('tests');
  return tests.map((t) => ({
    params: { test: t.id },
    props: { test: { id: t.id, ...t.data } as TestFile },
  }));
}) satisfies GetStaticPaths;

const { test } = Astro.props as { test: TestFile };
---

<Base title={test.title} section="testlar">
  <TopBar
    slot="topbar"
    title={test.title}
    sub={`${test.questions.length} та савол · ҳар бирида 4 та вариант`}
    backHref={url('testlar')}
    backLabel="Тестлар рўйхатига қайтиш"
  />

  <TestRunner test={test} homeHref={url()} listHref={url('testlar')} client:only="preact" />
</Base>
