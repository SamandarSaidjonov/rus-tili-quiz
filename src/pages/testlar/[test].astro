---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import TestRunner from '../../components/TestRunner.tsx';
import { url } from '../../lib/url.ts';
import type { TestFile } from '../../lib/types.ts';

export const getStaticPaths = (async () => {
  const tests = await getCollection('tests');
  return tests.map((t) => ({
    params: { test: t.id },
    props: { test: { id: t.id, ...t.data } as TestFile },
  }));
}) satisfies GetStaticPaths;

const { test } = Astro.props as { test: TestFile };
const list = url(test.group === 'mixed' ? 'testlar/mixed' : 'testlar/mavzu');
const groupName = { mixed: 'Аралаш мавзулар', grammar: 'Грамматика', vocab: 'Луғат' }[test.group];
---

<Base title={`${groupName} · ${test.title}`} section="testlar">
  <TopBar
    slot="topbar"
    title={test.title}
    sub={`${groupName} · ${test.questions.length} та савол · ҳар бирида 4 та вариант`}
    backHref={list}
    backLabel="Тестлар рўйхатига қайтиш"
  />

  <TestRunner test={test} homeHref={url()} listHref={list} client:only="preact" />
</Base>
