---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url.ts';

const tests = (await getCollection('tests')).sort((a, b) => b.data.no - a.data.no);
---

<Base title="Тестлар" section="testlar" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url()} aria-label="Бош саҳифага қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>Тестлар</h1>
  </div>

  <p class="rt-muted">
    Ҳар бир тестда 10 та савол: мавзулардан, луғатдан ва машқлардан. Саволлар ҳамма учун бир хил,
    фақат вариантлар тартиби аралашади. Натижа охирида чиқади.
  </p>

  {
    tests.length === 0 && (
      <div class="rt-card">
        <p style="margin:0">Тестлар ҳозир тайёрланмоқда.</p>
      </div>
    )
  }

  <ul class="rt-tests rt-grid">
    {
      tests.map((t) => (
        <li>
          <a class="rt-test" href={url(`testlar/${t.id}`)}>
            <span>
              <b>{t.data.title}</b>
              <small data-prog={`test:${t.id}:${t.data.questions.length}`}>
                {t.data.questions.length} та савол
              </small>
            </span>
            <span
              class="rt-badge rt-badge--todo"
              data-prog-badge={`test:${t.id}:${t.data.questions.length}`}
            >
              Топширилмаган
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
