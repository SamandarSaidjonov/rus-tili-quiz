---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url.ts';

const tests = await getCollection('tests');
const mixed = tests.filter((t) => t.data.group === 'mixed');
const byTopic = tests.filter((t) => t.data.group !== 'mixed');
const ids = (list: typeof tests): string => list.map((t) => t.id).join(' ');

const cards = [
  {
    path: 'testlar/mixed',
    icon: 'test' as const,
    title: 'Аралаш мавзулар',
    hint: 'Грамматика ва луғат бирга',
    count: `${mixed.length} та тест`,
    ids: ids(mixed),
  },
  {
    path: 'testlar/mavzu',
    icon: 'book' as const,
    title: 'Танланган мавзу бўйича',
    hint: 'Грамматика мавзулари ва луғатлар',
    count: `${byTopic.length} та тест`,
    ids: ids(byTopic),
  },
];
---

<Base title="Тестлар" section="testlar" wide>
  <div class="rt-pagehead">
    <a class="rt-back" href={url()} aria-label="Бош саҳифага қайтиш">
      <Icon name="arrow-left" />
    </a>
    <h1>Тестлар</h1>
  </div>

  <p class="rt-muted">
    Ҳар бир тестда 20 та савол. Саволлар ҳамма учун бир хил, фақат вариантлар тартиби аралашади.
    Натижа охирида чиқади.
  </p>

  <div class="rt-stack rt-stack--tight rt-grid rt-grid--2">
    {
      cards.map((c) => (
        <a class="rt-section" href={url(c.path)} data-sum-kind="test" data-sum-ids={c.ids}>
          <span class="rt-section__icon">
            <Icon name={c.icon} />
          </span>
          <span>
            <span class="rt-section__title" role="heading" aria-level="2">
              {c.title}
            </span>
            <span class="rt-section__meta">{c.hint}</span>
            <span class="rt-section__meta" data-sum-meta>
              {c.count}
            </span>
            <span class="rt-bar">
              <i style="width:0%" />
            </span>
          </span>
          <span class="rt-section__go">
            <Icon name="chevron-right" />
          </span>
        </a>
      ))
    }
  </div>

  <script>
    import { hydrateProgress } from '../../lib/progress-ui.ts';
    hydrateProgress();
  </script>
</Base>
