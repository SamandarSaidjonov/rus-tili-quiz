---
import { Font } from 'astro:assets';
import BottomNav from '../components/BottomNav.astro';
import { url, type SectionKey } from '../lib/url.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: SectionKey;
  /** Рўйхатли саҳифа: кенг экранда карточкалар бир неча устунга бўлинади. */
  wide?: boolean;
}

const {
  title,
  description = 'Рус тилини ўрганиш: мавзулар, машқлар, луғат ва тестлар.',
  section,
  wide = false,
} = Astro.props;

const fullTitle = title === 'Рус тили' ? title : `${title} · Рус тили`;
---

<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: бош экрандан очилганда Android саҳифани тепа ва пастки
         тизим панеллари остига ҳам чизади. Шунда env(safe-area-inset-*) ишлайди
         ва пастки навигация панел остида қолиб кетмайди. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f4f0" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111317" />
    <Font cssVariable="--font-uz" preload />
    <Font cssVariable="--font-ru" />
    <Font cssVariable="--font-display" preload />
    <script is:inline>
      // Темани саҳифа чизилишидан олдин қўямиз, шунда ранг сакраб кетмайди.
      try {
        var saved = localStorage.getItem('rt2:theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="rt-skip" href="#main">Асосий қисмга ўтиш</a>

    <slot name="topbar" />

    <main id="main" class:list={['rt-page', wide && 'rt-page--wide']}>
      <slot />
    </main>

    <BottomNav section={section} />

    <script>
      import { runMigration } from '../lib/migrate.ts';

      // Эски версиянинг прогрессини бир марта кўчирамиз.
      try {
        runMigration();
      } catch {
        /* прогресс кўчмаса ҳам сайт ишлайди */
      }

      // Офлайн ишлаши ва бош экранга қўшиш учун
      if ('serviceWorker' in navigator) {
        // Эски service worker янгиси билан алмашса, саҳифани бир марта қайта юклаймиз:
        // акс ҳолда эски HTML ўчиб кетган CSS'ни сўраб, саҳифа услубсиз қолади.
        const hadController = Boolean(navigator.serviceWorker.controller);
        let reloading = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!hadController || reloading) return;
          reloading = true;
          location.reload();
        });

        window.addEventListener('load', () => {
          const base = import.meta.env.BASE_URL.endsWith('/')
            ? import.meta.env.BASE_URL
            : `${import.meta.env.BASE_URL}/`;
          navigator.serviceWorker
            .register(`${base}sw.js`, { scope: base, updateViaCache: 'none' })
            .catch(() => {
              /* service worker ишламаса ҳам сайт ишлайди */
            });
        });
      }
    </script>
  </body>
</html>
