---
import { Font } from 'astro:assets';
import BottomNav from '../components/BottomNav.astro';
import { url, type SectionKey } from '../lib/url.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  section?: SectionKey;
}

const { title, description = 'Рус тилини ўрганиш: мавзулар, машқлар, луғат ва тестлар.', section } =
  Astro.props;

const fullTitle = title === 'Рус тили' ? title : `${title} · Рус тили`;
---

<!doctype html>
<html lang="uz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content="#2f5bd4" />
    <Font cssVariable="--font-uz" preload />
    <Font cssVariable="--font-ru" />
    <script is:inline>
      // Темани саҳифа чизилишидан олдин қўямиз, шунда ранг сакраб кетмайди.
      try {
        var saved = localStorage.getItem('rt2:theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Асосий қисмга ўтиш</a>
    <header class="site-head">
      <div class="site-head__row">
        <a class="site-head__name" href={url()}>Рус тили</a>
        <button
          class="iconbtn"
          id="theme-btn"
          type="button"
          aria-label="Ёруғ ёки қоронғи тема"
          title="Ёруғ ёки қоронғи тема"
        >
          <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
            <path
              d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5A6.5 6.5 0 0 1 12 3.5z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <BottomNav section={section} />

    <main id="main">
      <slot />
    </main>

    <script>
      import { runMigration } from '../lib/migrate.ts';
      import { writeRaw } from '../lib/progress.ts';

      // Эски версиянинг прогрессини бир марта кўчирамиз.
      try {
        runMigration();
      } catch {
        /* прогресс кўчмаса ҳам сайт ишлайди */
      }

      // Офлайн ишлаши ва бош экранга қўшиш учун
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const base = import.meta.env.BASE_URL.endsWith('/')
            ? import.meta.env.BASE_URL
            : `${import.meta.env.BASE_URL}/`;
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => {
            /* service worker ишламаса ҳам сайт ишлайди */
          });
        });
      }

      document.getElementById('theme-btn')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        writeRaw('rt2:theme', next);
      });
    </script>
  </body>
</html>
