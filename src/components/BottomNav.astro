---
import { url, SECTIONS, type SectionKey } from '../lib/url.ts';

interface Props {
  section?: SectionKey;
}

const { section } = Astro.props;

const icons: Record<SectionKey, string> = {
  mavzular:
    '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  mashqlar:
    '<path d="M4 17.5 16.2 5.3a2 2 0 0 1 2.8 2.8L6.8 20.3 3.5 21z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14.5 7 17 9.5" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  lugatlar:
    '<rect x="4" y="4" width="16" height="16" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 9h8M8 13h8M8 17h4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  testlar:
    '<path d="M6 4h12v16H6z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m9 11 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 16h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
};
---

<nav class="nav" aria-label="Асосий бўлимлар">
  <div class="nav__row">
    {
      SECTIONS.map((s) => (
        <a
          class="nav__link"
          href={url(s.key)}
          aria-current={section === s.key ? 'page' : undefined}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[s.key]} />
          <span>{s.title}</span>
          <span class="nav__dot"></span>
        </a>
      ))
    }
  </div>
</nav>
