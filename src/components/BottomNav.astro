---
import Icon from './Icon.astro';
import { url, SECTIONS, type SectionKey } from '../lib/url.ts';
import type { IconName } from '../lib/icons.ts';

interface Props {
  section?: SectionKey;
}

const { section } = Astro.props;

/** Тартиб ва иконкалар ўзгармайди (design/components/BottomNav). */
const icons: Record<SectionKey, IconName> = {
  mavzular: 'book',
  mashqlar: 'pencil',
  lugatlar: 'cards',
  testlar: 'test',
};
---

<nav class="rt-nav" aria-label="Бўлимлар">
  {
    SECTIONS.map((s) => (
      <a
        class="rt-nav__item"
        href={url(s.key)}
        aria-current={section === s.key ? 'page' : undefined}
      >
        <Icon name={icons[s.key]} />
        <span>{s.title}</span>
      </a>
    ))
  }
</nav>
