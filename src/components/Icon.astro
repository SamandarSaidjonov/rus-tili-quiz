---
import { ICONS, type IconName } from '../lib/icons.ts';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: cls } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class={cls}
  set:html={ICONS[name]}
/>
